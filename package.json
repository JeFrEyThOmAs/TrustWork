{
  "name": "trustwork-platform",
  "version": "2.0.0",
  "description": "TrustWork — Decentralized Professional Reputation, W3C Verifiable Credentials & Dual-Signed Blockchain Digital Agreement Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:contracts": "node scripts/compile-contracts.js",
    "server": "node --no-warnings server/index.js",
    "client": "vite",
    "dev": "concurrently -n SERVER,CLIENT -c cyan,yellow \"node --no-warnings server/index.js\" \"vite\"",
    "build": "node scripts/compile-contracts.js && vite build",
    "start": "NODE_ENV=production node --no-warnings server/index.js",
    "test": "node --no-warnings tests/verify-protocol.js"
  },
  "dependencies": {
    "@ethereumjs/vm": "latest",
    "cors": "^2.8.5",
    "ethers": "^6.13.4",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "solc": "^0.8.28"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.6",
    "vite": "^6.0.5"
  }
}
